# ============================================================================

CLASS EnsembleModel:
    """
    Ensemble of XGBoost and LightGBM models
    """
    
    FUNCTION __init__(self, config):
        self.config = config
        self.xgb_model = XGBoostModel(config)
        self.lgb_model = LightGBMModel(config)
        self.ensemble_method = config.ML_SETTINGS['ensemble']['method']
        self.xgb_weight = config.ML_SETTINGS['ensemble']['xgb_weight']
        self.lgb_weight = config.ML_SETTINGS['ensemble']['lgb_weight']
    
    FUNCTION train(self, X_train, y_train, X_val=None, y_val=None):
        """
        Train both models
        """
        # Train XGBoost
        self.xgb_model.train(X_train, y_train, X_val, y_val)
        
        # Train LightGBM
        self.lgb_model.train(X_train, y_train, X_val, y_val)
        
        # Calculate ensemble weights based on validation performance
        IF X_val IS NOT None AND y_val IS NOT None:
            self._calculate_optimal_weights(X_val, y_val)
    
    FUNCTION predict(self, X):
        """
        Generate ensemble predictions
        """
        # Get individual predictions
        xgb_pred = self.xgb_model.predict(X)
        lgb_pred = self.lgb_model.predict(X)
        
        # Ensemble predictions
        IF self.ensemble_method == 'weighted_average':
            ensemble_pred = (self.xgb_weight * xgb_pred + 
                           self.lgb_weight * lgb_pred)
        ELIF self.ensemble_method == 'voting':
            # Convert to binary and vote
            xgb_binary = (xgb_pred > 0.5).astype(int)
            lgb_binary = (lgb_pred > 0.5).astype(int)
            ensemble_pred = np.where(
                xgb_binary + lgb_binary >= 1, 1, 0
            ).astype(float)
        ELIF self.ensemble_method == 'stacking':
            # Use XGBoost as meta-learner
            ensemble_pred = self._stacking_ensemble(X, xgb_pred, lgb_pred)
        
        RETURN ensemble_pred
    
    FUNCTION predict_proba(self, X):
        """
        Generate ensemble probability predictions
        """
        xgb_pred = self.xgb_model.predict(X)
        lgb_pred = self.lgb_model.predict(X)
        
        IF self.ensemble_method == 'weighted_average':
            ensemble_proba = (self.xgb_weight * xgb_pred + 
                            self.lgb_weight * lgb_pred)
        ELSE:
            ensemble_proba = (xgb_pred + lgb_pred) / 2
        
        RETURN ensemble_proba
    
    FUNCTION _calculate_optimal_weights(self, X_val, y_val):
        """
        Calculate optimal ensemble weights using validation data
        """
        # Get individual predictions
        xgb_pred = self.xgb_model.predict(X_val)
        lgb_pred = self.lgb_model.predict(X_val)
        
        # Try different weight combinations
        best_accuracy = 0
        best_xgb_weight = 0.5
        
        FOR w IN np.linspace(0, 1, 21):
            ensemble_pred = w * xgb_pred + (1 - w) * lgb_pred
            ensemble_binary = (ensemble_pred > 0.5).astype(int)
            accuracy = np.mean(ensemble_binary == y_val)
            
            IF accuracy > best_accuracy:
                best_accuracy = accuracy
                best_xgb_weight = w
        
        self.xgb_weight = best_xgb_weight
        self.lgb_weight = 1 - best_xgb_weight
    
    FUNCTION _stacking_ensemble(self, X, xgb_pred, lgb_pred):
        """
        Stacking ensemble using meta-learner
        """
        # Create meta-features
        meta_features = np.column_stack([xgb_pred, lgb_pred])
        
        # Train meta-learner (simple logistic regression)
        from sklearn.linear_model import LogisticRegression
        meta_model = LogisticRegression()
        
        # Train on out-of-fold predictions
        # (Simplified implementation)
        meta_model.fit(meta_features, y_val)
        
        # Make predictions
        ensemble_pred = meta_model.predict_proba(meta_features)[:, 1]
        
        RETURN ensemble_pred
    
    FUNCTION get_feature_importance(self):
        """
        Get combined feature importance
        """
        xgb_importance = self.xgb_model.get_feature_importance()
        lgb_importance = self.lgb_model.get_feature_importance()
        
        # Combine importance scores
        combined_importance = (xgb_importance + lgb_importance) / 2
        RETURN combined_importance
    
    FUNCTION save_models(self, xgb_path, lgb_path):
        """
        Save both models
        """
        self.xgb_model.save_model(xgb_path)
        self.lgb_model.save_model(lgb_path)
    
    FUNCTION load_models(self, xgb_path, lgb_path):
        """
        Load both models
        """
        self.xgb_model.load_model(xgb_path)
        self.lgb_model.load_model(lgb_path)

