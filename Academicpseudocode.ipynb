CLASS FeatureEngineer:
    """
    Feature engineering for GARCH-XGBoost-LightGBM hybrid model
    """
    
    FUNCTION __init__(self, config):
        self.config = config
        self.feature_names = []
        self.scaler = StandardScaler()
    
    FUNCTION create_features(self, data, garch_features, technical_indicators):
        """
        Create comprehensive feature set for machine learning
        """
        feature_dict = {}
        
        # 1. GARCH Volatility Features
        feature_dict['volatility'] = garch_features['annualized_volatility']
        feature_dict['volatility_regime'] = garch_features['volatility_regime']
        feature_dict['volatility_change'] = garch_features['volatility_change']
        feature_dict['volatility_ma'] = garch_features['volatility_ma']
        feature_dict['volatility_std'] = garch_features['volatility_std']
        
        # 2. Technical Indicator Features
        feature_dict['vwap_deviation'] = technical_indicators['vwap']['vwap_deviation']
        feature_dict['adx'] = technical_indicators['adx']['adx']
        feature_dict['rsi'] = technical_indicators['rsi']['rsi']
        feature_dict['macd_histogram'] = technical_indicators['macd']['histogram']
        feature_dict['bollinger_width'] = technical_indicators['bollinger']['band_width']
        feature_dict['atr_percent'] = technical_indicators['atr']['atr_percent']
        
        # 3. Momentum Features
        FOR period IN [5, 10, 21, 63, 126, 252]:
            feature_dict[f'momentum_{period}d'] = data['Close'].pct_change(period)
        
        # 4. Price-based Features
        feature_dict['high_low_ratio'] = data['High'] / data['Low']
        feature_dict['close_open_ratio'] = data['Close'] / data['Open']
        feature_dict['volume_ratio'] = data['Volume'] / data['Volume'].rolling(20).mean()
        
        # 5. Cross-feature Interactions
        feature_dict['volatility_adx'] = feature_dict['volatility'] * feature_dict['adx']
        feature_dict['momentum_rsi'] = feature_dict['momentum_21d'] * feature_dict['rsi']
        feature_dict['vwap_momentum'] = feature_dict['vwap_deviation'] * feature_dict['momentum_21d']
        
        # 6. Lag Features
        FOR lag IN self.config.FEATURE_SETTINGS['lag_features']:
            feature_dict[f'close_lag_{lag}'] = data['Close'].shift(lag)
            feature_dict[f'returns_lag_{lag}'] = data['returns'].shift(lag)
        
        # 7. Rolling Window Features
        FOR stat IN ['mean', 'std', 'min', 'max']:
            window = self.config.FEATURE_SETTINGS['rolling_features']['window']
            feature_dict[f'close_rolling_{stat}'] = data['Close'].rolling(window).agg(stat)
        
        # 8. Market Condition Features
        feature_dict['market_trend'] = np.where(data['Close'] > data['Close'].rolling(200).mean(), 1, 0)
        feature_dict['volatility_regime_encoded'] = self._encode_regime(feature_dict['volatility_regime'])
        
        # Convert to DataFrame
        features_df = pd.DataFrame(feature_dict)
        
        # Handle missing values
        features_df = features_df.fillna(method='ffill').fillna(method='bfill')
        
        RETURN features_df
    
    FUNCTION _encode_regime(self, regime_array):
        """
        One-hot encode volatility regimes
        """
        encoded = pd.get_dummies(regime_array, prefix='regime')
        RETURN encoded.values
    
    FUNCTION scale_features(self, features, fit=True):
        """
        Scale features for machine learning
        """
        IF fit:
            scaled_features = self.scaler.fit_transform(features)
        ELSE:
            scaled_features = self.scaler.transform(features)
        
        RETURN scaled_features

