CLASS DissertationDataLoader:
    """
    Systematic data loading and preprocessing for dissertation research
    """
    
    FUNCTION __init__(self, data_file='SP500_data.xlsx'):
        self.data_file = data_file
        self.raw_data = None
        self.processed_data = None
        self.required_columns = ['Date', 'Open', 'High', 'Low', 'Close', 'Volume']
        
    FUNCTION load_data(self):
        """
        Load and validate S&P 500 data
        """
        TRY:
            # Load Excel file
            self.raw_data = pd.read_excel(self.data_file)
            
            # Validate required columns
            FOR column IN self.required_columns:
                IF column NOT IN self.raw_data.columns:
                    RAISE ValueError(f"Missing required column: {column}")
            
            # Process dates
            self.raw_data['date'] = pd.to_datetime(self.raw_data['Date'])
            self.raw_data.sort_values('date', inplace=True)
            self.raw_data.reset_index(drop=True, inplace=True)
            
            # Calculate returns
            self.raw_data['returns'] = self.raw_data['Close'].pct_change()
            self.raw_data['log_returns'] = np.log(self.raw_data['Close'] / self.raw_data['Close'].shift(1))
            
            # Handle missing values
            self.raw_data.fillna(method='ffill', inplace=True)
            self.raw_data.dropna(inplace=True)
            
            # Calculate additional features
            self.raw_data['high_low_ratio'] = self.raw_data['High'] / self.raw_data['Low']
            self.raw_data['close_open_ratio'] = self.raw_data['Close'] / self.raw_data['Open']
            
            RETURN self.raw_data
            
        CATCH FileNotFoundError:
            LOG_ERROR("Data file not found. Please ensure SP500_data.xlsx exists.")
            EXIT(1)
        CATCH Exception AS e:
            LOG_ERROR(f"Error loading data: {str(e)}")
            EXIT(1)
    
    FUNCTION filter_by_date(self, start_date, end_date):
        """
        Filter data for specific date range
        """
        mask = (self.processed_data['date'] >= start_date) & (self.processed_data['date'] <= end_date)
        RETURN self.processed_data[mask]
    
    FUNCTION create_train_test_split(self, data, test_size=0.2):
        """
        Create train-test split for machine learning validation
        """
        split_idx = int(len(data) * (1 - test_size))
        train_data = data.iloc[:split_idx]
        test_data = data.iloc[split_idx:]
        RETURN train_data, test_data
    
    FUNCTION validate_data_quality(self, data):
        """
        Validate data quality for research integrity
        """
        quality_metrics = {
            'missing_values': data.isnull().sum().to_dict(),
            'duplicates': data.duplicated().sum(),
            'date_gaps': self._check_date_continuity(data),
            'outliers': self._detect_outliers(data['returns']),
            'data_completeness': len(data) / self._expected_data_points() * 100
        }
        
        RETURN quality_metrics

