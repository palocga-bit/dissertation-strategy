CLASS DissertationBacktester:
    """
    Comprehensive backtesting framework for dissertation research
    """
    
    FUNCTION __init__(self, config, data_loader, garch_model, 
                     technical_indicators, signal_generator, position_manager):
        self.config = config
        self.data_loader = data_loader
        self.garch_model = garch_model
        self.technical_indicators = technical_indicators
        self.signal_generator = signal_generator
        self.position_manager = position_manager
        self.performance_metrics = {}
        self.equity_curve = []
        
    FUNCTION run_backtest(self, start_date, end_date, period_name):
        """
        Run backtest for specified period
        """
        PRINT(f"\n{'='*60}")
        PRINT(f"RUNNING BACKTEST: {period_name}")
        PRINT(f"Period: {start_date} to {end_date}")
        PRINT(f"{'='*60}\n")
        
        # Step 1: Load and filter data
        data = self.data_loader.load_data()
        filtered_data = self.data_loader.filter_by_date(start_date, end_date)
        
        PRINT(f"Data points: {len(filtered_data)}")
        
        # Step 2: Calculate GARCH volatility
        garch_features = self.garch_model.estimate_volatility(
            filtered_data['returns'].values
        )
        
        # Step 3: Calculate technical indicators
        technical_indicators = {
            'vwap': self.technical_indicators.calculate_vwap(filtered_data),
            'adx': self.technical_indicators.calculate_adx(filtered_data),
            'rsi': self.technical_indicators.calculate_rsi(filtered_data),
            'macd': self.technical_indicators.calculate_macd(filtered_data),
            'bollinger': self.technical_indicators.calculate_bollinger_bands(filtered_data),
            'atr': self.technical_indicators.calculate_atr(filtered_data),
            'garch_volatility': garch_features
        }
        
        # Step 4: Train model (only for in-sample)
        IF period_name == 'In-Sample Validation (2007-2021)':
            self.signal_generator.train_model(
                filtered_data, 
                garch_features, 
                technical_indicators
            )
        
        # Step 5: Generate signals
        signals = self.signal_generator.generate_signals(
            filtered_data,
            garch_features,
            technical_indicators
        )
        
        # Step 6: Execute trading loop
        FOR i IN RANGE(len(filtered_data)):
            current_data = filtered_data.iloc[i]
            
            # Manage positions
            IF i > 0:
                self.position_manager.manage_positions(current_data)
            
            # Check for new signal
            IF len(self.position_manager.positions) == 0:
                IF signals[i] != 0:
                    entry_data = {
                        'date': current_data['date'],
                        'price': current_data['Close']
                    }
                    self.position_manager.execute_entry(entry_data, signals[i])
            
            # Record portfolio value
            self.equity_curve.append({
                'date': current_data['date'],
                'portfolio_value': self.position_manager.portfolio_value,
                'close': current_data['Close'],
                'return': current_data['returns']
            })
        
        # Step 7: Close remaining positions
        FOR position IN self.position_manager.positions:
            IF position['status'] == 'OPEN':
                current_data = filtered_data.iloc[-1]
                self.position_manager._close_position(
                    position,
                    current_data['Close'],
                    'PERIOD_END',
                    current_data['date']
                )
        
        # Step 8: Calculate performance metrics
        self.performance_metrics = self.calculate_comprehensive_metrics()
        
        # Step 9: Generate report
        self.generate_performance_report(period_name)
        
        RETURN self.performance_metrics
    
    FUNCTION calculate_comprehensive_metrics(self):
        """
        Calculate comprehensive performance metrics
        """
        equity = pd.DataFrame(self.equity_curve)
        
        # Basic metrics
        total_return = (equity['portfolio_value'].iloc[-1] / 
                       equity['portfolio_value'].iloc[0] - 1)
        
        # Annualized return
        years = len(equity) / 252
        cagr = (1 + total_return) ** (1 / years) - 1
        
        # Risk metrics
        daily_returns = equity['portfolio_value'].pct_change().dropna()
        volatility = daily_returns.std() * np.sqrt(252)
        
        # Sharpe ratio
        risk_free_rate = self.config.RISK_MANAGEMENT['risk_free_rate']
        sharpe_ratio = (cagr - risk_free_rate) / volatility
        
        # Sortino ratio
        downside_returns = daily_returns[daily_returns < 0]
        downside_deviation = downside_returns.std() * np.sqrt(252)
        sortino_ratio = (cagr - risk_free_rate) / downside_deviation if downside_deviation != 0 else 0
        
        # Maximum drawdown
        cumulative = (1 + equity['portfolio_value'].pct_change()).cumprod()
        running_max = cumulative.expanding().max()
        drawdown = (cumulative - running_max) / running_max
        max_drawdown = drawdown.min()
        
        # Calmar ratio
        calmar_ratio = cagr / abs(max_drawdown) if max_drawdown != 0 else 0
        
        # Trade statistics
        trades = self.position_manager.trade_log
        trades_df = pd.DataFrame(trades)
        
        IF len(trades_df) > 0:
            exit_trades = trades_df[trades_df['type'] == 'EXIT']
            IF len(exit_trades) > 0:
                win_rate = (exit_trades['pnl'] > 0).mean()
                avg_win = exit_trades[exit_trades['pnl'] > 0]['pnl'].mean() if any(exit_trades['pnl'] > 0) else 0
                avg_loss = abs(exit_trades[exit_trades['pnl'] < 0]['pnl'].mean()) if any(exit_trades['pnl'] < 0) else 0
                profit_factor = avg_win / avg_loss if avg_loss != 0 else 0
                expectancy = (win_rate * avg_win) - ((1 - win_rate) * avg_loss)
            ELSE:
                win_rate = 0
                avg_win = 0
                avg_loss = 0
                profit_factor = 0
                expectancy = 0
        ELSE:
            win_rate = 0
            avg_win = 0
            avg_loss = 0
            profit_factor = 0
            expectancy = 0
        
        # Value at Risk
        var_95 = daily_returns.quantile(0.05)
        cvar_95 = daily_returns[daily_returns <= var_95].mean()
        
        # Statistical tests
        jb_stat, jb_pvalue = self._jarque_bera_test(daily_returns)
        
        metrics = {
            'total_return': total_return,
            'cagr': cagr,
            'volatility': volatility,
            'sharpe_ratio': sharpe_ratio,
            'sortino_ratio': sortino_ratio,
            'max_drawdown': max_drawdown,
            'calmar_ratio': calmar_ratio,
            'win_rate': win_rate,
            'profit_factor': profit_factor,
            'expectancy': expectancy,
            'avg_win': avg_win,
            'avg_loss': avg_loss,
            'var_95': var_95,
            'cvar_95': cvar_95,
            'jb_statistic': jb_stat,
            'jb_pvalue': jb_pvalue,
            'total_trades': len(exit_trades) if 'exit_trades' in locals() else 0,
            'period_days': len(equity)
        }
        
        RETURN metrics
    
    FUNCTION _jarque_bera_test(self, returns):
        """
        Jarque-Bera test for normality
        """
        n = len(returns)
        skewness = returns.skew()
        kurtosis = returns.kurtosis()
        
        jb_statistic = n/6 * (skewness**2 + (kurtosis-3)**2/4)
        
        from scipy.stats import chi2
        p_value = 1 - chi2.cdf(jb_statistic, 2)
        
        RETURN jb_statistic, p_value
    
    FUNCTION generate_performance_report(self, period_name):
        """
        Generate comprehensive performance report
        """
        PRINT(f"\n{'='*60}")
        PRINT(f"PERFORMANCE REPORT: {period_name}")
        PRINT(f"{'='*60}\n")
        
        metrics = self.performance_metrics
        
        PRINT("RETURN METRICS:")
        PRINT(f"  Total Return: {metrics['total_return']:.2%}")
        PRINT(f"  CAGR: {metrics['cagr']:.2%}")
        PRINT(f"  Volatility: {metrics['volatility']:.2%}")
        
        PRINT("\nRISK-ADJUSTED METRICS:")
        PRINT(f"  Sharpe Ratio: {metrics['sharpe_ratio']:.2f}")
        PRINT(f"  Sortino Ratio: {metrics['sortino_ratio']:.2f}")
        PRINT(f"  Max Drawdown: {metrics['max_drawdown']:.2%}")
        PRINT(f"  Calmar Ratio: {metrics['calmar_ratio']:.2f}")
        
        PRINT("\nTRADE STATISTICS:")
        PRINT(f"  Total Trades: {metrics['total_trades']}")
        PRINT(f"  Win Rate: {metrics['win_rate']:.2%}")
        PRINT(f"  Profit Factor: {metrics['profit_factor']:.2f}")
        PRINT(f"  Expectancy: ${metrics['expectancy']:,.2f}")
        PRINT(f"  Avg Win: ${metrics['avg_win']:,.2f}")
        PRINT(f"  Avg Loss: ${metrics['avg_loss']:,.2f}")
        
        PRINT("\nRISK METRICS:")
        PRINT(f"  VaR (95%): {metrics['var_95']:.2%}")
        PRINT(f"  CVaR (95%): {metrics['cvar_95']:.2%}")
        
        PRINT("\nSTATISTICAL TESTS:")
        PRINT(f"  Jarque-Bera Statistic: {metrics['jb_statistic']:.2f}")
        PRINT(f"  JB P-value: {metrics['jb_pvalue']:.4f}")
        
        IF metrics['jb_pvalue'] < 0.05:
            PRINT("  → Returns do NOT follow normal distribution")
        ELSE:
            PRINT("  → Returns follow normal distribution")

