CLASS PositionManager:
    """
    Position and risk management with multi-stage exits
    """
    
    # Ultimate Fixed Parameters
    TRAILING_STOP_DELTA = 0.0025      # Δ_opt = 0.25%
    PARTIAL_PROFIT_RATIO = 2.0        # PPR_opt = 2.0
    PARTIAL_PROFIT_SIZE = 0.50        # PPS_opt = 50%
    BREAKEVEN_BUFFER = 0.0020         # +0.20% safety
    MAX_HOLD_DAYS = 7                 # T_Max_opt = 7 days
    
    FUNCTION __init__(self, initial_capital=1000000):
        self.portfolio_value = initial_capital
        self.positions = []
        self.closed_positions = []
        self.trade_log = []
        self.portfolio_history = []
        
    FUNCTION calculate_position_size(self, current_price):
        """
        Calculate position size based on portfolio value
        """
        capital_per_trade = self.portfolio_value * 0.10  # 10% allocation
        shares = (capital_per_trade * 1.4) / current_price  # 1.4x leverage
        RETURN int(np.floor(shares))
    
    FUNCTION execute_entry(self, entry_data, signal_type):
        """
        Execute position entry
        """
        # Calculate position size
        shares = self.calculate_position_size(entry_data['price'])
        
        IF shares <= 0:
            RETURN None
        
        # Calculate exit levels
        IF signal_type == 1:  # Long
            tp1_level = entry_data['price'] * (1 + self.TRAILING_STOP_DELTA * self.PARTIAL_PROFIT_RATIO)
            stop_loss_level = entry_data['price'] * (1 - self.TRAILING_STOP_DELTA)
            breakeven_level = entry_data['price'] * (1 + self.BREAKEVEN_BUFFER)
        ELSE:  # Short
            tp1_level = entry_data['price'] * (1 - self.TRAILING_STOP_DELTA * self.PARTIAL_PROFIT_RATIO)
            stop_loss_level = entry_data['price'] * (1 + self.TRAILING_STOP_DELTA)
            breakeven_level = entry_data['price'] * (1 - self.BREAKEVEN_BUFFER)
        
        # Create position object
        position = {
            'entry_date': entry_data['date'],
            'entry_price': entry_data['price'],
            'shares': shares,
            'signal_type': signal_type,
            'tp1_level': tp1_level,
            'stop_loss_level': stop_loss_level,
            'breakeven_level': breakeven_level,
            'tp1_hit': False,
            'stage': 1,  # Stage 1: Initial risk
            'status': 'OPEN',
            'entry_index': len(self.trade_log),
            'highest_price': entry_data['price'] if signal_type == 1 else None,
            'lowest_price': entry_data['price'] if signal_type == -1 else None
        }
        
        # Add to positions
        self.positions.append(position)
        
        # Log trade entry
        self._log_trade_entry(position)
        
        RETURN position
    
    FUNCTION manage_positions(self, market_data):
        """
        Manage positions with multi-stage exit logic
        """
        current_price = market_data['close']
        current_date = market_data['date']
        current_high = market_data['high']
        current_low = market_data['low']
        
        positions_to_close = []
        
        FOR position IN self.positions:
            IF position['status'] != 'OPEN':
                CONTINUE
            
            # Update highest/lowest price
            IF position['signal_type'] == 1:
                IF position['highest_price'] IS None OR current_high > position['highest_price']:
                    position['highest_price'] = current_high
            ELSE:
                IF position['lowest_price'] IS None OR current_low < position['lowest_price']:
                    position['lowest_price'] = current_low
            
            # STAGE 1: Initial Risk Phase
            IF NOT position['tp1_hit']:
                # Check for TP1 hit
                IF (position['signal_type'] == 1 AND current_high >= position['tp1_level']) OR \
                   (position['signal_type'] == -1 AND current_low <= position['tp1_level']):
                    
                    # Execute partial profit taking
                    partial_shares = int(position['shares'] * self.PARTIAL_PROFIT_SIZE)
                    
                    # Calculate profit
                    IF position['signal_type'] == 1:
                        profit = (position['tp1_level'] - position['entry_price']) * partial_shares
                    ELSE:
                        profit = (position['entry_price'] - position['tp1_level']) * partial_shares
                    
                    # Update portfolio
                    self.portfolio_value += profit
                    position['shares'] -= partial_shares
                    position['tp1_hit'] = True
                    position['stage'] = 2
                    
                    # Update breakeven level for remaining shares
                    IF position['signal_type'] == 1:
                        position['breakeven_level'] = position['entry_price'] * (1 + self.BREAKEVEN_BUFFER)
                    ELSE:
                        position['breakeven_level'] = position['entry_price'] * (1 - self.BREAKEVEN_BUFFER)
                    
                    self._log_partial_exit(position, position['tp1_level'], partial_shares)
                
                # Check Stage 1 trailing stop
                stage1_stop = self._calculate_stage1_stop(position)
                IF self._stop_triggered(stage1_stop, current_price, position['signal_type']):
                    positions_to_close.append({
                        'position': position,
                        'exit_price': current_price,
                        'exit_reason': 'STAGE_1_TSL'
                    })
            
            # STAGE 2: Risk-Free Phase
            ELSE:
                # Check breakeven stop
                IF self._breakeven_triggered(position['breakeven_level'], current_price, position['signal_type']):
                    positions_to_close.append({
                        'position': position,
                        'exit_price': current_price,
                        'exit_reason': 'BREAKEVEN'
                    })
                    CONTINUE
                
                # Check Stage 2 trailing stop (80% of initial)
                stage2_delta = self.TRAILING_STOP_DELTA * 0.80
                stage2_stop = self._calculate_stage2_stop(position, stage2_delta)
                IF self._stop_triggered(stage2_stop, current_price, position['signal_type']):
                    positions_to_close.append({
                        'position': position,
                        'exit_price': current_price,
                        'exit_reason': 'STAGE_2_TSL'
                    })
            
            # MAX HOLDING PERIOD CHECK
            days_held = (current_date - position['entry_date']).days
            IF days_held >= self.MAX_HOLD_DAYS:
                positions_to_close.append({
                    'position': position,
                    'exit_price': current_price,
                    'exit_reason': 'MAX_HOLD'
                })
        
        # Execute position closures
        FOR close_data IN positions_to_close:
            self._close_position(
                close_data['position'],
                close_data['exit_price'],
                close_data['exit_reason'],
                current_date
            )
        
        # Remove closed positions
        self.positions = [p FOR p IN self.positions IF p['status'] == 'OPEN']
        
        # Update portfolio history
        self.portfolio_history.append({
            'date': current_date,
            'portfolio_value': self.portfolio_value,
            'open_positions': len(self.positions)
        })
    
    FUNCTION _calculate_stage1_stop(self, position):
        """
        Calculate Stage 1 trailing stop
        """
        IF position['signal_type'] == 1:
            # Long: trailing stop below highest price
            IF position['highest_price'] is not None:
                return position['highest_price'] * (1 - self.TRAILING_STOP_DELTA)
            ELSE:
                return position['entry_price'] * (1 - self.TRAILING_STOP_DELTA)
        ELSE:
            # Short: trailing stop above lowest price
            IF position['lowest_price'] is not None:
                return position['lowest_price'] * (1 + self.TRAILING_STOP_DELTA)
            ELSE:
                return position['entry_price'] * (1 + self.TRAILING_STOP_DELTA)
    
    FUNCTION _calculate_stage2_stop(self, position, delta):
        """
        Calculate Stage 2 trailing stop (reduced)
        """
        IF position['signal_type'] == 1:
            # Long: trailing stop below highest price
            IF position['highest_price'] is not None:
                return position['highest_price'] * (1 - delta)
            ELSE:
                return position['breakeven_level']
        ELSE:
            # Short: trailing stop above lowest price
            IF position['lowest_price'] is not None:
                return position['lowest_price'] * (1 + delta)
            ELSE:
                return position['breakeven_level']
    
    FUNCTION _stop_triggered(self, stop_level, current_price, signal_type):
        """
        Check if stop loss is triggered
        """
        IF signal_type == 1:
            RETURN current_price <= stop_level
        ELSE:
            RETURN current_price >= stop_level
    
    FUNCTION _breakeven_triggered(self, breakeven_level, current_price, signal_type):
        """
        Check if breakeven stop is triggered
        """
        IF signal_type == 1:
            RETURN current_price <= breakeven_level
        ELSE:
            RETURN current_price >= breakeven_level
    
    FUNCTION _close_position(self, position, exit_price, exit_reason, exit_date):
        """
        Close a position
        """
        # Calculate P&L
        IF position['signal_type'] == 1:
            pnl = (exit_price - position['entry_price']) * position['shares']
            return_pct = (exit_price / position['entry_price'] - 1) * 100
        ELSE:
            pnl = (position['entry_price'] - exit_price) * position['shares']
            return_pct = (position['entry_price'] / exit_price - 1) * 100
        
        # Update portfolio
        self.portfolio_value += pnl
        
        # Update position
        position['exit_date'] = exit_date
        position['exit_price'] = exit_price
        position['pnl'] = pnl
        position['return_pct'] = return_pct
        position['exit_reason'] = exit_reason
        position['status'] = 'CLOSED'
        position['days_held'] = (exit_date - position['entry_date']).days
        
        # Move to closed positions
        self.closed_positions.append(position)
        
        # Log trade exit
        self._log_trade_exit(position)
    
    FUNCTION _log_trade_entry(self, position):
        """
        Log trade entry
        """
        log_entry = {
            'type': 'ENTRY',
            'date': position['entry_date'],
            'price': position['entry_price'],
            'shares': position['shares'],
            'signal_type': position['signal_type'],
            'tp1_level': position['tp1_level'],
            'stop_loss': position['stop_loss_level'],
            'portfolio_value': self.portfolio_value
        }
        self.trade_log.append(log_entry)
    
    FUNCTION _log_partial_exit(self, position, exit_price, shares):
        """
        Log partial exit
        """
        log_entry = {
            'type': 'PARTIAL_EXIT',
            'date': position['entry_date'],  # Current date would be added
            'price': exit_price,
            'shares': shares,
            'remaining_shares': position['shares'],
            'stage': position['stage'],
            'portfolio_value': self.portfolio_value
        }
        self.trade_log.append(log_entry)
    
    FUNCTION _log_trade_exit(self, position):
        """
        Log trade exit
        """
        log_entry = {
            'type': 'EXIT',
            'date': position['exit_date'],
            'price': position['exit_price'],
            'shares': position['shares'],
            'pnl': position['pnl'],
            'return_pct': position['return_pct'],
            'exit_reason': position['exit_reason'],
            'days_held': position['days_held'],
            'portfolio_value': self.portfolio_value
        }
        self.trade_log.append(log_entry)

