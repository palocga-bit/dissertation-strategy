CLASS SignalGenerator:
    """
    Signal generation using GARCH-XGBoost-LightGBM ensemble
    """
    
    FUNCTION __init__(self, config):
        self.config = config
        self.confidence_threshold = config.ULTIMATE_PARAMETERS['confidence_threshold']
        self.ensemble_model = None
        self.feature_engineer = FeatureEngineer(config)
        self.signals = None
    
    FUNCTION train_model(self, data, garch_features, technical_indicators):
        """
        Train the ensemble model
        """
        # Create features
        features = self.feature_engineer.create_features(
            data, garch_features, technical_indicators
        )
        
        # Create target (next day return direction)
        target = (data['returns'].shift(-1) > 0).astype(int).values[:-1]
        
        # Remove last row (no target)
        features = features.iloc[:-1]
        
        # Split into train/validation
        train_size = int(0.8 * len(features))
        X_train = features.iloc[:train_size]
        y_train = target[:train_size]
        X_val = features.iloc[train_size:]
        y_val = target[train_size:]
        
        # Scale features
        X_train_scaled = self.feature_engineer.scale_features(X_train, fit=True)
        X_val_scaled = self.feature_engineer.scale_features(X_val, fit=False)
        
        # Train ensemble
        self.ensemble_model = EnsembleModel(self.config)
        self.ensemble_model.train(X_train_scaled, y_train, X_val_scaled, y_val)
        
        RETURN self.ensemble_model
    
    FUNCTION generate_signals(self, data, garch_features, technical_indicators):
        """
        Generate trading signals using ensemble model
        """
        # Create features
        features = self.feature_engineer.create_features(
            data, garch_features, technical_indicators
        )
        
        # Scale features
        features_scaled = self.feature_engineer.scale_features(features, fit=False)
        
        # Get predictions
        IF self.ensemble_model:
            predictions = self.ensemble_model.predict_proba(features_scaled)
        ELSE:
            # Fallback: use technical indicators only
            predictions = self._generate_technical_signal(technical_indicators)
        
        # Generate signals based on confidence threshold
        signals = np.zeros(len(predictions))
        signals[predictions > (0.5 + self.confidence_threshold)] = 1    # Long
        signals[predictions < (0.5 - self.confidence_threshold)] = -1   # Short
        
        # Apply additional filters
        signals = self._apply_filters(signals, data, technical_indicators)
        
        self.signals = signals
        RETURN signals
    
    FUNCTION _generate_technical_signal(self, technical_indicators):
        """
        Fallback: Generate signal using technical indicators only
        """
        # Combine technical signals
        vwap_signal = technical_indicators['vwap']['vwap_signal']
        adx_signal = np.where(technical_indicators['adx']['adx'] > 25, 1, 0)
        rsi_signal = technical_indicators['rsi']['signal']
        
        # Weighted combination
        combined_signal = (0.3 * vwap_signal + 
                          0.3 * adx_signal + 
                          0.4 * rsi_signal)
        
        # Normalize to [0, 1] range
        normalized_signal = (combined_signal + 1) / 2
        RETURN normalized_signal
    
    FUNCTION _apply_filters(self, signals, data, technical_indicators):
        """
        Apply additional filters to signals
        """
        filtered_signals = signals.copy()
        
        # Filter 1: ADX trend filter (only trade when trend is strong)
        adx = technical_indicators['adx']['adx']
        filtered_signals[adx < 20] = 0
        
        # Filter 2: Volatility filter (avoid trading during extreme volatility)
        volatility = technical_indicators['garch_volatility']['annualized_volatility']
        filtered_signals[volatility > 0.30] = 0
        
        # Filter 3: Momentum filter (avoid trading when momentum is zero)
        momentum = data['Close'].pct_change(21)
        filtered_signals[momentum == 0] = 0
        
        RETURN filtered_signals
    
    FUNCTION get_model_performance(self, X_test, y_test):
        """
        Evaluate model performance
        """
        IF self.ensemble_model IS None:
            RETURN None
        
        predictions = self.ensemble_model.predict(X_test)
        binary_predictions = (predictions > 0.5).astype(int)
        
        # Calculate metrics
        accuracy = np.mean(binary_predictions == y_test)
        
        from sklearn.metrics import precision_score, recall_score, f1_score
        precision = precision_score(y_test, binary_predictions)
        recall = recall_score(y_test, binary_predictions)
        f1 = f1_score(y_test, binary_predictions)
        
        performance = {
            'accuracy': accuracy,
            'precision': precision,
            'recall': recall,
            'f1_score': f1
        }
        
        RETURN performance

