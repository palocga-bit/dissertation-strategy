CLASS XGBoostModel:
    """
    XGBoost implementation for signal prediction
    """
    
    FUNCTION __init__(self, config):
        self.config = config
        self.model = None
        self.params = config.ML_SETTINGS['xgboost']
        self.feature_importance = None
    
    FUNCTION train(self, X_train, y_train, X_val=None, y_val=None):
        """
        Train XGBoost model
        """
        # Create DMatrix objects
        dtrain = xgb.DMatrix(X_train, label=y_train)
        
        IF X_val IS NOT None AND y_val IS NOT None:
            dval = xgb.DMatrix(X_val, label=y_val)
            evals = [(dtrain, 'train'), (dval, 'eval')]
        ELSE:
            evals = [(dtrain, 'train')]
        
        # Train model
        self.model = xgb.train(
            self.params,
            dtrain,
            num_boost_round=1000,
            evals=evals,
            early_stopping_rounds=50,
            verbose_eval=100
        )
        
        # Calculate feature importance
        self.feature_importance = self.model.get_score(importance_type='weight')
        
        RETURN self.model
    
    FUNCTION predict(self, X):
        """
        Generate predictions
        """
        dtest = xgb.DMatrix(X)
        predictions = self.model.predict(dtest)
        RETURN predictions
    
    FUNCTION predict_proba(self, X):
        """
        Generate probability predictions
        """
        dtest = xgb.DMatrix(X)
        predictions = self.model.predict(dtest)
        RETURN predictions
    
    FUNCTION get_feature_importance(self):
        """
        Get feature importance scores
        """
        RETURN self.feature_importance
    
    FUNCTION save_model(self, filepath):
        """
        Save trained model
        """
        self.model.save_model(filepath)
    
    FUNCTION load_model(self, filepath):
        """
        Load trained model
        """
        self.model = xgb.Booster()
        self.model.load_model(filepath)

CLASS LightGBMModel:
    """
    LightGBM implementation for signal prediction
    """
    
    FUNCTION __init__(self, config):
        self.config = config
        self.model = None
        self.params = config.ML_SETTINGS['lightgbm']
        self.feature_importance = None
    
    FUNCTION train(self, X_train, y_train, X_val=None, y_val=None):
        """
        Train LightGBM model
        """
        # Create datasets
        train_data = lgb.Dataset(X_train, label=y_train)
        
        IF X_val IS NOT None AND y_val IS NOT None:
            val_data = lgb.Dataset(X_val, label=y_val)
            valid_sets = [train_data, val_data]
        ELSE:
            valid_sets = [train_data]
        
        # Train model
        self.model = lgb.train(
            self.params,
            train_data,
            num_boost_round=1000,
            valid_sets=valid_sets,
            early_stopping_rounds=50,
            verbose_eval=100
        )
        
        # Calculate feature importance
        self.feature_importance = self.model.feature_importance(importance_type='gain')
        
        RETURN self.model
    
    FUNCTION predict(self, X):
        """
        Generate predictions
        """
        predictions = self.model.predict(X, num_iteration=self.model.best_iteration)
        RETURN predictions
    
    FUNCTION predict_proba(self, X):
        """
        Generate probability predictions
        """
        predictions = self.model.predict(X, num_iteration=self.model.best_iteration)
        RETURN predictions
    
    FUNCTION get_feature_importance(self):
        """
        Get feature importance scores
        """
        RETURN self.feature_importance
    
    FUNCTION save_model(self, filepath):
        """
        Save trained model
        """
        self.model.save_model(filepath)
    
    FUNCTION load_model(self, filepath):
        """
        Load trained model
        """
        self.model = lgb.Booster(model_file=filepath)

