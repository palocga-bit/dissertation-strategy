CLASS TechnicalIndicators:
    """
    Comprehensive technical indicator calculations for feature engineering
    """
    
    FUNCTION __init__(self):
        self.indicator_settings = {
            'vwap': {'enabled': True},
            'adx': {'period': 14, 'enabled': True},
            'rsi': {'period': 14, 'enabled': True},
            'macd': {'fast': 12, 'slow': 26, 'signal': 9, 'enabled': True},
            'bollinger': {'period': 20, 'std': 2, 'enabled': True},
            'momentum': {'period': 21, 'enabled': True},
            'atr': {'period': 14, 'enabled': True}
        }
    
    FUNCTION calculate_vwap(self, data):
        """
        Volume-Weighted Average Price (VWAP)
        Academic Significance: Institutional benchmark for trading execution
        """
        typical_price = (data['High'] + data['Low'] + data['Close']) / 3
        typical_volume = typical_price * data['Volume']
        
        cum_typical_volume = np.cumsum(typical_volume)
        cum_volume = np.cumsum(data['Volume'])
        
        vwap = cum_typical_volume / cum_volume
        
        # Calculate VWAP deviation
        vwap_deviation = (data['Close'] - vwap) / vwap
        
        RETURN {
            'vwap': vwap,
            'vwap_deviation': vwap_deviation,
            'vwap_signal': np.where(data['Close'] > vwap, 1, -1)
        }
    
    FUNCTION calculate_adx(self, data, period=14):
        """
        Average Directional Index (ADX)
        Quantifies trend strength (0-100 scale)
        """
        high, low, close = data['High'], data['Low'], data['Close']
        
        # True Range
        true_range = np.maximum(
            high - low,
            np.maximum(
                np.abs(high - close.shift(1)),
                np.abs(low - close.shift(1))
            )
        )
        
        # Directional Movements
        plus_dm = np.maximum(0, high - high.shift(1))
        minus_dm = np.maximum(0, low.shift(1) - low)
        
        # Smoothed Averages
        atr = pd.Series(true_range).rolling(period).mean().values
        plus_di = 100 * (pd.Series(plus_dm).rolling(period).mean() / atr).values
        minus_di = 100 * (pd.Series(minus_dm).rolling(period).mean() / atr).values
        
        # DX and ADX
        dx = 100 * np.abs(plus_di - minus_di) / (plus_di + minus_di)
        adx = pd.Series(dx).rolling(period).mean().values
        
        # Trend interpretation
        trend_strength = np.where(adx > 50, 'very_strong',
                                 np.where(adx > 25, 'strong',
                                         np.where(adx > 20, 'moderate', 'weak')))
        
        RETURN {
            'adx': adx,
            'plus_di': plus_di,
            'minus_di': minus_di,
            'trend_strength': trend_strength,
            'trend_signal': np.where(plus_di > minus_di, 1, -1)
        }
    
    FUNCTION calculate_rsi(self, data, period=14):
        """
        Relative Strength Index (RSI)
        Momentum oscillator identifying overbought/oversold conditions
        """
        price_changes = data['Close'].diff()
        
        gains = np.maximum(price_changes, 0)
        losses = np.abs(np.minimum(price_changes, 0))
        
        avg_gain = pd.Series(gains).rolling(period).mean().values
        avg_loss = pd.Series(losses).rolling(period).mean().values
        
        # Avoid division by zero
        avg_loss[avg_loss == 0] = 0.0001
        
        rs = avg_gain / avg_loss
        rsi = 100 - (100 / (1 + rs))
        
        # RSI signals
        rsi_signal = np.where(rsi > 70, -1,  # Overbought - Short signal
                             np.where(rsi < 30, 1,  # Oversold - Long signal
                                     0))  # Neutral
        
        RETURN {
            'rsi': rsi,
            'signal': rsi_signal,
            'overbought': rsi > 70,
            'oversold': rsi < 30
        }
    
    FUNCTION calculate_macd(self, data):
        """
        Moving Average Convergence Divergence (MACD)
        Trend-following momentum indicator
        """
        fast_ema = data['Close'].ewm(span=12, adjust=False).mean()
        slow_ema = data['Close'].ewm(span=26, adjust=False).mean()
        
        macd_line = fast_ema - slow_ema
        signal_line = macd_line.ewm(span=9, adjust=False).mean()
        histogram = macd_line - signal_line
        
        # MACD signals
        macd_signal = np.where(
            (macd_line > signal_line) & (macd_line.shift(1) <= signal_line.shift(1)), 1,
            np.where((macd_line < signal_line) & (macd_line.shift(1) >= signal_line.shift(1)), -1, 0)
        )
        
        RETURN {
            'macd_line': macd_line,
            'signal_line': signal_line,
            'histogram': histogram,
            'signal': macd_signal
        }
    
    FUNCTION calculate_bollinger_bands(self, data, period=20, std=2):
        """
        Bollinger Bands
        Volatility-based price bands
        """
        rolling_mean = data['Close'].rolling(period).mean()
        rolling_std = data['Close'].rolling(period).std()
        
        upper_band = rolling_mean + (rolling_std * std)
        lower_band = rolling_mean - (rolling_std * std)
        
        # Bollinger band signals
        bollinger_signal = np.where(
            data['Close'] > upper_band, -1,  # Overbought
            np.where(data['Close'] < lower_band, 1,  # Oversold
                    0)  # Neutral
        )
        
        # Band width (volatility measure)
        band_width = (upper_band - lower_band) / rolling_mean
        
        RETURN {
            'upper_band': upper_band,
            'lower_band': lower_band,
            'middle_band': rolling_mean,
            'signal': bollinger_signal,
            'band_width': band_width,
            'percent_b': (data['Close'] - lower_band) / (upper_band - lower_band)
        }
    
    FUNCTION calculate_atr(self, data, period=14):
        """
        Average True Range (ATR)
        Market volatility measure
        """
        high, low, close = data['High'], data['Low'], data['Close']
        
        true_range = np.maximum(
            high - low,
            np.maximum(
                np.abs(high - close.shift(1)),
                np.abs(low - close.shift(1))
            )
        )
        
        atr = pd.Series(true_range).rolling(period).mean().values
        
        RETURN {
            'atr': atr,
            'atr_percent': (atr / data['Close']) * 100,
            'atr_signal': np.where(atr > atr.mean(), 1, -1)
        }

