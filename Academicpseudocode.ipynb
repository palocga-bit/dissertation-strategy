CLASS DissertationMain:
    """
    Main execution class for dissertation research
    """
    
    FUNCTION __init__(self):
        self.config = DissertationConfig()
        self.data_loader = DissertationDataLoader()
        self.garch_model = GARCHVolatilityModel()
        self.technical_indicators = TechnicalIndicators()
        self.position_manager = PositionManager(
            self.config.ULTIMATE_PARAMETERS['initial_capital']
        )
        self.signal_generator = SignalGenerator(self.config)
        self.backtester = DissertationBacktester(
            self.config,
            self.data_loader,
            self.garch_model,
            self.technical_indicators,
            self.signal_generator,
            self.position_manager
        )
        
    FUNCTION run_full_experiment(self):
        """
        Run complete dissertation experiment
        """
        PRINT("\n" + "="*80)
        PRINT("GARCH-XGBoost-LightGBM DISSERTATION STRATEGY")
        PRINT("A Hybrid Approach to Quantitative Trading")
        PRINT("="*80 + "\n")
        
        # Display research parameters
        self._display_research_parameters()
        
        # Run in-sample validation
        in_sample_metrics = self.backtester.run_backtest(
            self.config.VALIDATION_PERIODS['in_sample']['start'],
            self.config.VALIDATION_PERIODS['in_sample']['end'],
            self.config.VALIDATION_PERIODS['in_sample']['name']
        )
        
        # Reset position manager
        self.position_manager = PositionManager(
            self.config.ULTIMATE_PARAMETERS['initial_capital']
        )
        self.backtester.position_manager = self.position_manager
        self.backtester.equity_curve = []
        
        # Run out-of-sample validation
        out_of_sample_metrics = self.backtester.run_backtest(
            self.config.VALIDATION_PERIODS['out_of_sample']['start'],
            self.config.VALIDATION_PERIODS['out_of_sample']['end'],
            self.config.VALIDATION_PERIODS['out_of_sample']['name']
        )
        
        # Generate comparison report
        self._generate_comparison_report(in_sample_metrics, out_of_sample_metrics)
        
        PRINT("\n" + "="*80)
        PRINT("RESEARCH COMPLETE")
        PRINT("="*80 + "\n")
    
    FUNCTION _display_research_parameters(self):
        """
        Display ultimate fixed parameters
        """
        PRINT("ULTIMATE FIXED PARAMETERS:")
        PRINT("-" * 40)
        FOR key, value IN self.config.ULTIMATE_PARAMETERS.items():
            PRINT(f"  {key}: {value}")
        PRINT("-" * 40 + "\n")
        
        PRINT("FEATURE ENGINEERING SETTINGS:")
        PRINT("-" * 40)
        PRINT(f"  Feature Groups: {list(self.config.FEATURE_SETTINGS.keys())}")
        PRINT(f"  Lag Features: {self.config.FEATURE_SETTINGS['lag_features']}")
        PRINT(f"  Rolling Windows: {self.config.FEATURE_SETTINGS['rolling_features']}")
        PRINT("-" * 40 + "\n")
    
    FUNCTION _generate_comparison_report(self, in_sample, out_of_sample):
        """
        Generate comparison report between in-sample and out-of-sample results
        """
        PRINT("\n" + "="*80)
        PRINT("PERFORMANCE COMPARISON REPORT")
        PRINT("="*80 + "\n")
        
        metrics_to_compare = [
            'total_return', 'cagr', 'sharpe_ratio', 'sortino_ratio',
            'max_drawdown', 'win_rate', 'profit_factor', 'total_trades'
        ]
        
        PRINT(f"{'Metric':<20} {'In-Sample':<15} {'Out-of-Sample':<15} {'Difference':<15}")
        PRINT("-" * 65)
        
        FOR metric IN metrics_to_compare:
            in_val = in_sample.get(metric, 0)
            out_val = out_of_sample.get(metric, 0)
            
            IF 'return' IN metric or 'cagr' IN metric or 'drawdown' IN metric:
                diff = (out_val - in_val) * 100
                PRINT(f"{metric:<20} {in_val:>14.2%} {out_val:>14.2%} {diff:>+14.2f}%")
            ELIF 'ratio' IN metric or 'factor' IN metric:
                diff = out_val - in_val
                PRINT(f"{metric:<20} {in_val:>14.2f} {out_val:>14.2f} {diff:>+14.2f}")
            ELSE:
                diff = out_val - in_val
                PRINT(f"{metric:<20} {in_val:>14.2f} {out_val:>14.2f} {diff:>+14.2f}")
        
        PRINT("\n" + "="*80)
        
        # Model validation
        PRINT("\nMODEL VALIDATION ASSESSMENT:")
        PRINT("-" * 40)
        
        # Check if out-of-sample performance is consistent
        perf_diff = (out_of_sample['cagr'] - in_sample['cagr']) / in_sample['cagr'] if in_sample['cagr'] != 0 else 0
        
        IF abs(perf_diff) < 0.20:
            PRINT("  ✓ Model demonstrates consistent performance across periods")
        ELIF perf_diff < 0:
            PRINT("  ⚠ Out-of-sample performance shows some degradation")
        ELSE:
            PRINT("  ✓ Out-of-sample performance shows improvement")
        
        # Check risk metrics
        sharpe_diff = out_of_sample['sharpe_ratio'] - in_sample['sharpe_ratio']
        IF abs(sharpe_diff) < 0.5:
            PRINT("  ✓ Risk-adjusted performance is stable")
        ELSE:
            PRINT("  ⚠ Risk-adjusted performance shows significant variation")
        
        PRINT("-" * 40 + "\n")

